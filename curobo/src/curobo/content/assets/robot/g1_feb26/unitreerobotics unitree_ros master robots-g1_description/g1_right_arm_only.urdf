<robot name="g1_right_arm_only">
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="white">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <mujoco>
    <compiler meshdir="meshes" discardvisual="false"/>
  </mujoco>

  <!-- Dummy Base Link representing the Torso connection point -->
  <link name="base_link">
     <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <!-- Arm -->
  <link name="right_shoulder_pitch_link">
    <inertial>
      <origin xyz="0 -0.035892 -0.011628" rpy="0 0 0"/>
      <mass value="0.718"/>
      <inertia ixx="0.0004291" ixy="-9.2E-06" ixz="6.4E-06" iyy="0.000453" iyz="2.26E-05" izz="0.000423"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_shoulder_pitch_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 -0.04 -0.01" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_shoulder_pitch_joint" type="revolute">
    <!-- Preserved Origin from g1_right_arm.urdf relative to torso (Mirrored Y) -->
    <!-- X: -0.0000072 (same), Y: -0.10022 (flipped), Z: 0.29178 (same) -->
    <!-- RPY: 0.27931 is roll? Need to check mirroring logic for RPY. 
         Usually roll is negated if symmetric about XZ plane. 
         Let's assume standard symmetry for now.
         Original Left: rpy="0.27931 5.4949E-05 -0.00019159"
         Right should probably be rpy="-0.27931 5.4949E-05 0.00019159"? 
         Let's check standard URDF mirroring conventions or existing g1 URDF if available.
         Safest bet is to flip Y translation. Rotation depends on frame definition.
         Assuming standard "mirroring" implies symmetric joint frames:
         Left Shoulder Pitch Axis: Y (0 1 0). Right Shoulder Pitch Axis: Y (0 1 0).
         If we just flip Y translation, the axis points "out" on left and "out" on right.
         Let's stick to simple Y-flip for translation and check rotation later if needed.
         Actually, looking at `g1_description` (if I had it) would be ideal.
         I will infer: Y-flip translation.
         RPY: Roll is rotation around X. 
         If I check `right_shoulder_pitch_joint` in main URDF if I could... I can't see right arm in `g1_left_arm.urdf` obviously.
         But standard humanoid: Right arm is at -Y.
         RPY: If left is pitched forward, right is pitched forward. If rolled out, right is rolled out.
         Left RPY: 0.27931 (Roll?), Pitch, Yaw.
         0.27931 rad = ~16 deg.
         If torzo->shoulder has 16 deg roll (shoulders 'shrugged' or 'drooped'?), symmetry dictates -16 deg for right?
         Let's try flipping Roll.
    -->
    <origin xyz="-0.0000072 -0.10022 0.29178" rpy="-0.27931 5.4949E-05 0.00019159"/>
    <parent link="base_link"/>
    <child link="right_shoulder_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0892" upper="2.6704" effort="25" velocity="37"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="right_shoulder_roll_link">
    <inertial>
      <!-- Original: -0.000227 0.00727 -0.063243 -->
      <origin xyz="-0.000227 -0.00727 -0.063243" rpy="0 0 0"/>
      <mass value="0.643"/>
      <inertia ixx="0.0006177" ixy="-1E-06" ixz="8.7E-06" iyy="0.0006912" iyz="-5.3E-06" izz="0.0003894"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_shoulder_roll_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <!-- Original: -0.004 0.006 -0.053 -->
      <origin xyz="-0.004 -0.006 -0.053" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_shoulder_roll_joint" type="revolute">
    <!-- Original: xyz="0 0.038 -0.013831" rpy="-0.27925 0 0" -->
    <origin xyz="0 -0.038 -0.013831" rpy="0.27925 0 0"/>
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.2515" upper="1.5882" effort="25" velocity="37"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="right_shoulder_yaw_link">
    <inertial>
      <!-- Original: 0.010773 -0.002949 -0.072009 -->
      <origin xyz="0.010773 0.002949 -0.072009" rpy="0 0 0"/>
      <mass value="0.734"/>
      <inertia ixx="0.0009988" ixy="7.9E-06" ixz="0.0001412" iyy="0.0010605" iyz="-2.86E-05" izz="0.0004354"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_shoulder_yaw_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_shoulder_yaw_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_shoulder_yaw_joint" type="revolute">
    <!-- Original: xyz="0 0.00624 -0.1032" rpy="0 0 0" -->
    <origin xyz="0 -0.00624 -0.1032" rpy="0 0 0"/>
    <parent link="right_shoulder_roll_link"/>
    <child link="right_shoulder_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="25" velocity="37"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="right_elbow_link">
    <inertial>
      <!-- Original: 0.064956 0.004454 -0.010062 -->
      <origin xyz="0.064956 -0.004454 -0.010062" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0002891" ixy="6.53E-05" ixz="1.72E-05" iyy="0.0004152" iyz="-5.6E-06" izz="0.0004197"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_elbow_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_elbow_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_elbow_joint" type="revolute">
    <!-- Original: xyz="0.015783 0 -0.080518" -->
    <origin xyz="0.015783 0 -0.080518" rpy="0 0 0"/>
    <parent link="right_shoulder_yaw_link"/>
    <child link="right_elbow_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0472" upper="2.0944" effort="25" velocity="37"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="right_wrist_roll_joint" type="revolute">
    <!-- Original: xyz="0.100 0.00188791 -0.010" -->
    <origin xyz="0.100 -0.00188791 -0.010" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <parent link="right_elbow_link"/>
    <child link="right_wrist_roll_link"/>
    <limit effort="25" velocity="37" lower="-1.972222054" upper="1.972222054"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
  <link name="right_wrist_roll_link">
    <inertial>
      <!-- Original: 0.01713944778 0.00053759094 0.00000048864 -->
      <origin xyz="0.01713944778 -0.00053759094 0.00000048864" rpy="0 0 0"/>
      <mass value="0.08544498"/>
      <inertia ixx="0.00004821544023" ixy="-0.00000424511021" ixz="0.00000000510599" iyy="0.00003722899093" iyz="-0.00000000123525" izz="0.00005482106541"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_roll_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_roll_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_wrist_pitch_joint" type="revolute">
    <!-- Original: xyz="0.038 0 0" -->
    <origin xyz="0.038 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="right_wrist_roll_link"/>
    <child link="right_wrist_pitch_link"/>
    <limit effort="5" velocity="22" lower="-1.614429558" upper="1.614429558"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
  <link name="right_wrist_pitch_link">
    <inertial>
      <!-- Original: 0.02299989837 -0.00111685314 -0.00111658096 -->
      <origin xyz="0.02299989837 0.00111685314 -0.00111658096" rpy="0 0 0"/>
      <mass value="0.48404956"/>
      <inertia ixx="0.00016579646273" ixy="-0.00001231206746" ixz="0.00001231699194" iyy="0.00042954057410" iyz="0.00000081417712" izz="0.00042953697654"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_pitch_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_pitch_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_wrist_yaw_joint" type="revolute">
    <!-- Original: xyz="0.046 0 0" -->
    <origin xyz="0.046 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="right_wrist_pitch_link"/>
    <child link="right_wrist_yaw_link"/>
    <!-- <limit effort="5" velocity="22" lower="-1.614429558" upper="1.614429558"/> -->
    <limit effort="5" velocity="22" lower="-1.0" upper="1.0"/> 
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
  <link name="right_wrist_yaw_link">
    <inertial>
      <!-- Original: 0.02200381568 0.00049485096 0.00053861123 -->
      <origin xyz="0.02200381568 -0.00049485096 0.00053861123" rpy="0 0 0"/>
      <mass value="0.08457647"/>
      <inertia ixx="0.00004929128828" ixy="-0.00000045735494" ixz="0.00000445867591" iyy="0.00005973338134" iyz="0.00000043217198" izz="0.00003928083826"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_yaw_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_wrist_yaw_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_hand_palm_joint" type="fixed">
    <!-- Original: xyz="0.0415 0.003 0" -->
    <origin xyz="0.0415 -0.003 0" rpy="0 0 0"/>
    <parent link="right_wrist_yaw_link"/>
    <child link="right_rubber_hand"/>
  </joint>
  <link name="right_rubber_hand">
    <inertial>
      <!-- Original: 0.05361310808 -0.00295905240 0.00215413091 -->
      <origin xyz="0.05361310808 0.00295905240 0.00215413091" rpy="0 0 0"/>
      <mass value="0.170"/>
      <inertia ixx="0.00010099485234748" ixy="0.00003618590790516" ixz="-0.00000074301518642" iyy="0.00028135871571621" iyz="0.00000330189743286" izz="0.00021894770413514"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_rubber_hand.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="dummy_ee_right_joint" type="fixed">
    <origin xyz="0.13 0.05 0" rpy="0 0 0" />
    <parent link="right_rubber_hand" />
    <child link="dummy_ee_right_link" />
  </joint>
  <link name="dummy_ee_right_link" />
</robot>
